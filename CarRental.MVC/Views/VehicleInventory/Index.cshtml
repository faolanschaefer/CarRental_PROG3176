@model IEnumerable<VehicleViewModel>

@{
    ViewData["Title"] = "Vehicle Inventory";
}

<h1>Vehicle Inventory</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Vehicle Id</th>
            <th>Make</th>
            <th>Model</th>
            <th>Location Id</th>
            <th>Type</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.VehicleId</td>
                    <td>@item.Make</td>
                    <td>@item.Model</td>
                    <td>@item.LocationId</td>
                    <td>@item.VehicleType</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">No vehicles found.</td>
            </tr>
        }
    </tbody>
</table>