{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "ApiKey": "5214eee0-0f8c-407b-9bc4-3b33db2030a2"
  },
  "ReverseProxy": {
    "Routes": {
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/v1/vehicles/{**catch-all}"
        }
      },
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/api/v1/maintenance/{**catch-all}"
        }
      },
      "customers-route": {
        "ClusterId": "customers-cluster",
        "Match": {
          "Path": "/api/v1/customers/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:53342/"
          }
        }
      },
      "maintenance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7289/"
          }
        }
      },
      "customers-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7014/"
          }
        }
      }
    }
  }
}
